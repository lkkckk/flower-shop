generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  parentId  Int?
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryChildren")
  sort      Int        @default(0)
  createdAt DateTime   @default(now())

  products  Product[]
}

model Product {
  productType     String @default("standard")
  drinkGroups     DrinkOptionGroup[]
  drinkVariants   DrinkVariant[]
  id              Int       @id @default(autoincrement())
  name            String
  category        String?
  categoryId      Int?
  baseUnit        String
  grade           String?
  color           String?
  specification   String?
  defaultPrice    Decimal @db.Decimal(12, 2)
  memberPrice     Decimal? @db.Decimal(12, 2)
  vipPrice        Decimal? @db.Decimal(12, 2)
  wholesalePrice  Decimal? @db.Decimal(12, 2)
  shelfLifeDays   Int      @default(7)
  attributes      String?   // JSON string（暂保留字符串形态，未来可迁移为 Json 类型）
  status          String   @default("active")
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categoryRef     Category?        @relation(fields: [categoryId], references: [id])
  unitConversions UnitConversion[]
  stockBatches    StockBatch[]
  orderItems      OrderItem[]
  recipe          ProductRecipe?   @relation("ProductRecipeProduct")
  recipeComponents ProductRecipeItem[] @relation("ProductRecipeComponent")
}

model DrinkOptionGroup {
  id String @id
  productId Int
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name String
  sort Int @default(0)
  active Boolean @default(true)
  options DrinkOption[]
  @@index([productId])
}

model DrinkOption {
  id String @id
  groupId String
  group DrinkOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name String
  sort Int @default(0)
  active Boolean @default(true)
  @@index([groupId])
}

model DrinkVariant {
  id String @id
  productId Int
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  selectionKey String
  options Json
  price Decimal? @db.Decimal(12, 2)
  enabled Boolean @default(false)
  orderItems OrderItem[]
  @@unique([productId, selectionKey])
}

model UnitConversion {
  id          Int     @id @default(autoincrement())
  productId   Int
  fromUnit    String
  toBaseQty   Decimal @db.Decimal(12, 3)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, fromUnit])
}

model ProductRecipe {
  id        Int      @id @default(autoincrement())
  productId Int     @unique
  enabled   Boolean @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation("ProductRecipeProduct", fields: [productId], references: [id], onDelete: Cascade)
  items   ProductRecipeItem[]
}

model ProductRecipeItem {
  id                 Int     @id @default(autoincrement())
  recipeId           Int
  componentProductId Int
  qty                Decimal @db.Decimal(12, 3)
  unit               String
  sort               Int     @default(0)
  notes              String?

  recipe           ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  componentProduct Product       @relation("ProductRecipeComponent", fields: [componentProductId], references: [id])

  @@index([recipeId])
  @@index([componentProductId])
}

model StockBatch {
  specialPrice Decimal? @db.Decimal(12, 2)
  specialUntil DateTime?
  specialQty Decimal @default(0) @db.Decimal(12, 3)
  costAllocations OrderCostAllocation[]
  id           Int      @id @default(autoincrement())
  productId    Int
  batchNo      String   @unique
  inboundDate  DateTime
  expiryDate   DateTime
  inboundQty   Decimal @db.Decimal(12, 3)
  currentQty   Decimal @db.Decimal(12, 3)
  costPrice    Decimal @db.Decimal(12, 2)
  status       String   @default("in_stock")
  notes        String?
  createdAt    DateTime @default(now())

  product      Product         @relation(fields: [productId], references: [id])
  orderItems   OrderItem[]
  movements    StockMovement[]

  @@index([productId, status])
  @@index([expiryDate])
}

model StockMovement {
  operatorUserId Int?
  sourceKey String? @unique
  id             Int      @id @default(autoincrement())
  batchId        Int
  type           String
  qtyChange      Decimal @db.Decimal(12, 3)
  relatedOrderId Int?
  operator       String?
  notes          String?
  createdAt      DateTime @default(now())

  batch          StockBatch @relation(fields: [batchId], references: [id])

  @@index([createdAt])
}

model Customer {
  storedValueBalance Decimal @default(0) @db.Decimal(12, 2)
  receivableBalance Decimal @default(0) @db.Decimal(12, 2)
  availablePoints Int @default(0)
  creditLimit Decimal? @db.Decimal(12, 2)
  preferences String?
  status String @default("active")
  mergedIntoId Int?
  accountEntries CustomerAccountEntry[]
  pointEntries PointEntry[]
  tags CustomerTag[]
  events CustomerEvent[]
  contacts CustomerContact[]
  id          Int      @id @default(autoincrement())
  name        String
  phone       String?  @unique
  address     String?
  level       String   @default("normal")
  balance     Decimal    @default(0) @db.Decimal(12, 2)
  totalOwed   Decimal    @default(0) @db.Decimal(12, 2)
  points      Int      @default(0)
  notes       String?
  // 微信小程序账号字段
  openid      String?  @unique
  unionid     String?
  nickname    String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]
  payments    Payment[]

  @@index([phone])
  @@index([openid])
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("staff") // staff | admin | cashier
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  processedOrders Order[] @relation("OrderCashier")
  createdPreorderRegistrations PreorderRegistration[] @relation("PreorderRegCreatedBy")
  updatedPreorderRegistrations PreorderRegistration[] @relation("PreorderRegUpdatedBy")
  trashedPreorderRegistrations PreorderRegistration[] @relation("PreorderRegTrashedBy")
  trashedOrders                Order[]                @relation("OrderTrashedBy")
}

/// 全局单行配置（key-value）
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// 站内通知（铃铛 + /notifications 页）
/// 由 server/utils/notificationGenerator.ts 定时生成，按 dedupeKey 去重避免刷屏
model Notification {
  id         Int       @id @default(autoincrement())
  type       String    // 'low_stock' | 'expiring_batch' | 'debt_overdue' | 'anomaly_order'
  level      String    @default("info") // 'info' | 'warn' | 'urgent'
  title      String
  body       String
  /// 关联对象类型
  refType    String?   // 'product' | 'batch' | 'customer' | 'order'
  refId      Int?
  /// 接收者：null 表示全店通知；指定 userId 时仅该用户可见
  userId     Int?
  readAt     DateTime?
  /// 去重键 `{type}:{refId}:{YYYY-MM-DD}` — 同一类同一对象同一天只生成一条
  dedupeKey  String    @unique
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@index([type, createdAt])
}

/// 促销活动：满 X 减 Y
model Promotion {
  id         Int       @id @default(autoincrement())
  name       String
  type       String    @default("full_reduction") // full_reduction（预留阶梯/折扣）
  threshold  Decimal @db.Decimal(12, 2)
  reduction  Decimal @db.Decimal(12, 2)
  status     String    @default("active") // active | inactive
  startAt    DateTime?
  endAt      DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  orders     Order[]
}

model Order {
  paymentStatus String @default("unpaid")
  fulfillmentStatus String @default("pending")
  completedAt DateTime?
  refundedAmount Decimal @default(0) @db.Decimal(12, 2)
  pointsRedeemed Int @default(0)
  pointsDiscount Decimal @default(0) @db.Decimal(12, 2)
  priceReason String?
  deliveryPerson String?
  deliveryPhone String?
  adjustments OrderAdjustment[]
  costAllocations OrderCostAllocation[]
  fulfillmentEvents FulfillmentEvent[]
  id              Int      @id @default(autoincrement())
  orderNo         String   @unique
  customerId      Int?
  orderType       String   @default("retail")
  totalAmount     Decimal @db.Decimal(12, 2)
  paidAmount      Decimal    @default(0) @db.Decimal(12, 2)
  owedAmount      Decimal    @default(0) @db.Decimal(12, 2)
  paymentMethod   String?
  deliveryTime    DateTime?
  deliveryAddress String?
  notes           String?
  // 订单标签，逗号分隔存储，用于列表批量打标与快速筛选
  tags            String?
  status          String   @default("pending")
  // 履约方式：delivery | pickup，供预售排单/备货看板使用
  fulfillmentType String   @default("delivery")
  // 是否已做好：轻量制作完成标记，不等同于完整订单状态流转
  isMade          Boolean  @default(false)
  // 是否加急/插单：用于排单优先展示
  isUrgent        Boolean  @default(false)
  // 手动排序预留字段
  sortIndex       Int      @default(0)
  // 价格模式：retail | vip | wholesale | discount | promotion
  priceMode       String?
  // 整单折扣率（0-100），仅 priceMode=discount 时使用
  discountRate    Decimal? @db.Decimal(12, 2)
  promotionId     Int?
  // 预售单收货人信息（可能与下单客户不同）
  receiverName      String?
  receiverPhone     String?
  // 贺卡内容（鲜花预售常见，独立于 notes 以便单独打印）
  cardMessage       String?
  // 订单来源/渠道标记（如 "美团闪购#5"、"抖音#12"、"店内"），打印右上角显示
  sourceChannel     String?
  // 预售履约提醒阶段：none | d7 | d3 | due | overdue
  reminderStage     String?   @default("none")
  reminderUpdatedAt DateTime?
  // 结账收银员
  cashierId         Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer        Customer?   @relation(fields: [customerId], references: [id])
  promotion       Promotion?  @relation(fields: [promotionId], references: [id])
  cashier         User?       @relation("OrderCashier", fields: [cashierId], references: [id])
  trashedAt       DateTime?
  trashedById     Int?
  trashedBy       User?       @relation("OrderTrashedBy", fields: [trashedById], references: [id])
  items           OrderItem[]
  payments        Payment[]

  @@index([createdAt])
  @@index([customerId])
  @@index([orderType, deliveryTime])
  @@index([orderType, deliveryTime, isMade])
  @@index([orderType, status])
  @@index([trashedAt])
}

model OrderItem {
  variantId String?
  variant DrinkVariant? @relation(fields: [variantId], references: [id])
  productNameSnapshot String?
  variantLabel String?
  productTypeSnapshot String?
  returnedQty Decimal @default(0) @db.Decimal(12, 3)
  costAllocations OrderCostAllocation[]
  id            Int     @id @default(autoincrement())
  orderId       Int
  productId     Int
  // 预售单创建时不绑定批次，批次在转执行阶段按 FIFO 分配
  batchId       Int?
  unit          String
  qty           Decimal @db.Decimal(12, 3)
  baseQty       Decimal @db.Decimal(12, 3)
  unitPrice     Decimal @db.Decimal(12, 2)
  /// 成交价所基于的基础价（priceMode 应用前的参考价，用于审计）
  originalPrice Decimal? @db.Decimal(12, 2)
  subtotal      Decimal @db.Decimal(12, 2)
  grade         String?
  color         String?
  notes         String?
  // 预售下单时保存的商品参考图（下单瞬间的商品图片快照，用于配送单打印）
  imageUrl      String?

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
  batch       StockBatch? @relation(fields: [batchId], references: [id])
}

model Payment {
  operatorUserId Int?
  cashShiftId Int?
  sourceKey String? @unique
  id              Int      @id @default(autoincrement())
  customerId      Int?
  orderId         Int?
  amount          Decimal @db.Decimal(12, 2)
  paymentMethod   String
  type            String
  operator        String?
  notes           String?
  createdAt       DateTime @default(now())

  customer        Customer? @relation(fields: [customerId], references: [id])
  order           Order?    @relation(fields: [orderId], references: [id])

  @@index([customerId, createdAt])
}


// Ledger records are append-only; database triggers reject UPDATE and DELETE.
model CustomerAccountEntry {
  id Int @id @default(autoincrement())
  customerId Int
  customer Customer @relation(fields: [customerId], references: [id])
  account String
  amount Decimal @db.Decimal(12, 2)
  balanceAfter Decimal @db.Decimal(12, 2)
  type String
  orderId Int?
  paymentId Int?
  sourceKey String @unique
  operatorUserId Int?
  notes String?
  createdAt DateTime @default(now())
  @@index([customerId, account, createdAt])
}
model PointEntry {
  id Int @id @default(autoincrement())
  customerId Int
  customer Customer @relation(fields: [customerId], references: [id])
  amount Int
  balanceAfter Int
  type String
  orderId Int?
  sourceKey String @unique
  operatorUserId Int?
  notes String?
  createdAt DateTime @default(now())
  @@index([customerId, createdAt])
}
model Operation {
  id String @id
  action String
  requestHash String
  result Json?
  operatorUserId Int
  createdAt DateTime @default(now())
}
model AuditLog {
  id Int @id @default(autoincrement())
  action String
  entityType String
  entityId String
  operatorUserId Int?
  details Json
  createdAt DateTime @default(now())
  @@index([entityType, entityId, createdAt])
}
model OrderAdjustment {
  id Int @id @default(autoincrement())
  orderId Int
  order Order @relation(fields: [orderId], references: [id])
  type String
  status String @default("pending")
  reason String
  lines Json
  amount Decimal @db.Decimal(12, 2)
  refundMethod String?
  externalReference String?
  requestedBy Int
  approvedBy Int?
  approvedAt DateTime?
  createdAt DateTime @default(now())
}
model OrderCostAllocation {
  id Int @id @default(autoincrement())
  orderId Int
  order Order @relation(fields: [orderId], references: [id])
  orderItemId Int
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  batchId Int
  batch StockBatch @relation(fields: [batchId], references: [id])
  baseQty Decimal @db.Decimal(12, 3)
  unitCost Decimal @db.Decimal(12, 2)
  totalCost Decimal @db.Decimal(12, 2)
  adjustmentId Int?
  createdAt DateTime @default(now())
  @@index([orderId])
}
model CustomerTag {
  id Int @id @default(autoincrement())
  customerId Int
  customer Customer @relation(fields: [customerId], references: [id])
  name String
  @@unique([customerId, name])
}
model CustomerEvent {
  id Int @id @default(autoincrement())
  customerId Int
  customer Customer @relation(fields: [customerId], references: [id])
  title String
  calendar String @default("solar")
  month Int
  day Int
  remindDays Int @default(3)
  active Boolean @default(true)
}
model CustomerContact {
  id Int @id @default(autoincrement())
  customerId Int
  customer Customer @relation(fields: [customerId], references: [id])
  content String
  nextContactAt DateTime?
  completedAt DateTime?
  operatorUserId Int
  createdAt DateTime @default(now())
}
model FulfillmentEvent {
  id Int @id @default(autoincrement())
  orderId Int
  order Order @relation(fields: [orderId], references: [id])
  fromStatus String
  toStatus String
  operatorUserId Int
  notes String?
  createdAt DateTime @default(now())
}
model Supplier {
  id Int @id @default(autoincrement())
  name String
  phone String?
  address String?
  notes String?
  active Boolean @default(true)
  purchaseOrders PurchaseOrder[]
  entries SupplierAccountEntry[]
}
model PurchaseOrder {
  id Int @id @default(autoincrement())
  supplierId Int
  supplier Supplier @relation(fields: [supplierId], references: [id])
  status String @default("draft")
  expectedAt DateTime?
  notes String?
  operatorUserId Int
  items PurchaseOrderItem[]
  receipts GoodsReceipt[]
  createdAt DateTime @default(now())
}
model PurchaseOrderItem {
  id Int @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId Int
  qty Decimal @db.Decimal(12, 3)
  receivedQty Decimal @default(0) @db.Decimal(12, 3)
  unitCost Decimal @db.Decimal(12, 2)
}
model GoodsReceipt {
  id Int @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  lines Json
  totalAmount Decimal @db.Decimal(12, 2)
  sourceKey String @unique
  operatorUserId Int
  createdAt DateTime @default(now())
}
model SupplierAccountEntry {
  id Int @id @default(autoincrement())
  supplierId Int
  supplier Supplier @relation(fields: [supplierId], references: [id])
  amount Decimal @db.Decimal(12, 2)
  type String
  receiptId Int?
  paymentMethod String?
  sourceKey String @unique
  operatorUserId Int
  notes String?
  createdAt DateTime @default(now())
}
model CashShift {
  id Int @id @default(autoincrement())
  userId Int
  status String @default("open")
  openingCash Decimal @db.Decimal(12, 2)
  expectedCash Decimal? @db.Decimal(12, 2)
  countedCash Decimal? @db.Decimal(12, 2)
  variance Decimal? @db.Decimal(12, 2)
  notes String?
  openedAt DateTime @default(now())
  closedAt DateTime?
  movements CashMovement[]
}
model CashMovement {
  id Int @id @default(autoincrement())
  shiftId Int
  shift CashShift @relation(fields: [shiftId], references: [id])
  amount Decimal @db.Decimal(12, 2)
  type String
  sourceKey String @unique
  operatorUserId Int
  notes String
  createdAt DateTime @default(now())
}
model ImportJob {
  id Int @id @default(autoincrement())
  kind String
  rows Json
  errors Json
  status String @default("validated")
  operatorUserId Int
  createdAt DateTime @default(now())
  completedAt DateTime?
}

/// 预售自由登记（独立于商品、客户、账务和库存）
model PreorderRegistration {
  id           Int       @id @default(autoincrement())
  orderNo      String
  contactPhone String?
  deliveryTime DateTime?
  notes        String?
  cardMessage  String?
  version      Int       @default(1)
  createdById  Int
  updatedById  Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  trashedAt    DateTime?
  trashedById  Int?

  createdBy    User      @relation("PreorderRegCreatedBy", fields: [createdById], references: [id])
  updatedBy    User      @relation("PreorderRegUpdatedBy", fields: [updatedById], references: [id])
  trashedBy    User?     @relation("PreorderRegTrashedBy", fields: [trashedById], references: [id])
  items        PreorderRegistrationItem[]

  @@index([orderNo])
  @@index([contactPhone])
  @@index([deliveryTime])
  @@index([createdAt])
  @@index([trashedAt])
}

model PreorderRegistrationItem {
  id             Int       @id @default(autoincrement())
  registrationId Int
  name           String
  qty            Decimal   @db.Decimal(12, 3)
  amount         Decimal?  @db.Decimal(12, 2)
  sort           Int       @default(0)

  registration   PreorderRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  photos         PreorderRegistrationPhoto[]

  @@index([registrationId])
  @@index([name])
}

model PreorderRegistrationPhoto {
  id        Int       @id @default(autoincrement())
  itemId    Int
  url       String
  sort      Int       @default(0)
  createdAt DateTime  @default(now())

  item      PreorderRegistrationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

