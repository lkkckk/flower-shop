# PostgreSQL 数据库连接
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flower_shop?schema=public"

# JWT 签名密钥（生产环境必须改为强随机 32+ 字符）
JWT_SECRET="dev-secret-change-me-min-32-chars-please-change"

# 微信小程序凭证（微信公众平台 → 开发管理 → 开发设置）
WECHAT_APPID=""
WECHAT_SECRET=""

# CORS 允许的源（部署时必须改为真实域名，例如 https://shop.example.com；开发本机不需要设置）
CORS_ORIGIN="http://localhost:3000"

# 生产环境图片持久化目录；开发环境不设置则使用 public/products
PRODUCT_IMAGE_DIR=""

# 订单确认照片持久化目录；默认使用 PRODUCT_IMAGE_DIR 的同级 preorder-images 目录
# 生产环境应指向随数据库一起备份、发布时保留的绝对目录
PREORDER_IMAGE_DIR=""
